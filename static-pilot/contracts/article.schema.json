{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.customwaistbag.com/contracts/article.schema.json",
  "title": "Agent-ready article source package",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "slug", "publishedAt", "locales", "hero", "schema", "provenance", "review", "lifecycle"],
  "properties": {
    "kind": { "enum": ["blog", "resource"] },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "publishedAt": { "type": "string", "format": "date" },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "en": { "$ref": "#/$defs/localeContent" },
        "ru": { "$ref": "#/$defs/localeContent" }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "alt", "ocrStatus"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "alt": { "type": "string", "minLength": 1 },
        "ocrStatus": { "enum": ["passed", "pending-human", "blocked"] }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types"],
      "properties": {
        "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Article", "BlogPosting", "FAQPage", "BreadcrumbList"] } }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "review": { "$ref": "#/$defs/review" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" }
  },
  "$defs": {
    "localeContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "metaTitle", "description", "h1", "blocks"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "metaTitle": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "h1": { "type": "string", "minLength": 1 },
        "blocks": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePackage", "receivedAt", "operatorStatement"],
      "properties": {
        "sourcePackage": { "type": "string", "minLength": 1 },
        "receivedAt": { "type": "string", "format": "date-time" },
        "operatorStatement": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "facts", "translation", "seo", "assets"],
      "properties": {
        "status": { "enum": ["pending-human", "approved", "rejected"] },
        "facts": { "enum": ["pending-human", "approved", "rejected"] },
        "translation": { "enum": ["pending-human", "approved", "rejected"] },
        "seo": { "enum": ["pending-human", "approved", "rejected"] },
        "assets": { "enum": ["pending-human", "approved", "rejected"] }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "productionApproved"],
      "properties": {
        "action": { "enum": ["create", "update", "unpublish", "delete", "redirect"] },
        "productionApproved": { "const": false }
      }
    }
  }
}
