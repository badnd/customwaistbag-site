{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.customwaistbag.com/contracts/product.schema.json",
  "title": "Agent-ready product source package",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "model", "category", "slug", "publishedAt", "displayOrder", "locales", "faqs", "assets", "facts", "structuredData", "discovery", "provenance", "review", "lifecycle"],
  "properties": {
    "kind": { "const": "product" },
    "model": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
    "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "publishedAt": { "type": "string", "format": "date" },
    "displayOrder": { "type": "integer", "minimum": 0 },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/$defs/localeContent" },
        "ru": { "$ref": "#/$defs/localeContent" }
      }
    },
    "faqs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "type": "array", "items": { "$ref": "#/$defs/faq" } },
        "ru": { "type": "array", "items": { "$ref": "#/$defs/faq" } }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gallery", "cardImage"],
      "properties": {
        "gallery": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } },
        "cardImage": { "$ref": "#/$defs/asset" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specifications", "moqPolicy", "sampleLeadTime", "bulkLeadTime"],
      "properties": {
        "specifications": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "moqPolicy": { "$ref": "#/$defs/fact" },
        "sampleLeadTime": { "$ref": "#/$defs/fact" },
        "bulkLeadTime": { "$ref": "#/$defs/fact" }
      }
    },
    "structuredData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "breadcrumbs"],
      "properties": {
        "types": {
          "const": ["Product", "FAQPage", "BreadcrumbList"]
        },
        "breadcrumbs": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/breadcrumb" }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includeInSitemap", "hreflang", "relatedProducts"],
      "properties": {
        "includeInSitemap": { "type": "boolean" },
        "hreflang": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "ru", "x-default"],
          "properties": {
            "en": { "type": "string", "format": "uri" },
            "ru": { "type": "string", "format": "uri" },
            "x-default": { "type": "string", "format": "uri" }
          }
        },
        "relatedProducts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "review": { "$ref": "#/$defs/review" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" }
  },
  "$defs": {
    "localeContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "metaTitle", "description", "h1", "intro"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "metaTitle": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "h1": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "originalPath", "r2Key", "sha256", "pHash", "alt", "order", "ocrStatus"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "originalPath": { "type": "string", "minLength": 1 },
        "r2Key": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pHash": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "alt": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "ocrStatus": { "enum": ["passed", "pending-human", "blocked", "exempted"] },
        "ocrExemption": { "$ref": "#/$defs/ocrExemption" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence", "reviewStatus", "aiInference"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "reviewStatus": { "enum": ["confirmed", "pending-human", "rejected"] },
        "aiInference": { "type": "boolean" },
        "pendingReason": { "type": "string" }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 }
      }
    },
    "breadcrumb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "ocrExemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "boundSha256", "boundPHash", "approvedBy"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "boundSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "boundPHash": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "approvedBy": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePackage", "receivedAt", "operatorStatement"],
      "properties": {
        "sourcePackage": { "type": "string", "minLength": 1 },
        "receivedAt": { "type": "string", "format": "date-time" },
        "operatorStatement": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "facts", "translation", "seo", "assets"],
      "properties": {
        "status": { "enum": ["pending-human", "approved", "rejected"] },
        "facts": { "enum": ["pending-human", "approved", "rejected"] },
        "translation": { "enum": ["pending-human", "approved", "rejected"] },
        "seo": { "enum": ["pending-human", "approved", "rejected"] },
        "assets": { "enum": ["pending-human", "approved", "rejected"] }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "productionApproved"],
      "properties": {
        "action": { "enum": ["create", "update", "unpublish", "delete", "redirect"] },
        "productionApproved": { "const": false }
      }
    }
  }
}
